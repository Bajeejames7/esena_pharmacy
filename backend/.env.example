PORT=5000
NODE_ENV=development

# Database - TrueHost Configuration
DB_HOST=localhost
DB_USER=ohnokmqf_esena_user
DB_PASSWORD=Es3n@ph@rm@cy
DB_NAME=ohnokmqf_esena_pharmacy

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Storage quota (GB) - set to your hosting plan's total storage
STORAGE_QUOTA_GB=45

# ==========================================
# M-PESA DARAJA API (Safaricom)
# ==========================================
# Get credentials from: https://developer.safaricom.co.ke/
# Set to 'sandbox' for testing, 'production' for live payments
MPESA_ENVIRONMENT=sandbox

# Consumer Key & Secret from your Daraja App
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Your Business Till Number
MPESA_BUSINESS_SHORT_CODE=3611027

# Passkey from the Daraja Portal (STK Push passkey)
MPESA_PASSKEY=your_passkey_here

# MUST be HTTPS. Use ngrok for local dev: https://<id>.ngrok.io/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
