PORT=5000
NODE_ENV=development

# Database - TrueHost Configuration
DB_HOST=localhost
DB_USER=ohnokmqf_esena_user
DB_PASSWORD=Es3n@ph@rm@cy
DB_NAME=ohnokmqf_esena_pharmacy

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Email (Resend — sends over HTTPS, not raw SMTP, so it works on hosts like
# Render's free tier that block outbound SMTP ports 25/465/587)
RESEND_API_KEY=your_resend_api_key_here
# Until esena.co.ke is verified as a sending domain in Resend, this must stay
# on their shared onboarding domain — switch to "Esena Pharmacy <orders@esena.co.ke>"
# once that domain is verified there.
EMAIL_FROM=Esena Pharmacy <onboarding@resend.dev>
# Still used as the "send admin notifications to" address throughout the app
EMAIL_USER=your_gmail@gmail.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Storage quota (GB) - set to your hosting plan's total storage
STORAGE_QUOTA_GB=45

# Afymis POS Integration
POS_API_BASE_URL=https://afymis.cloud254.org/api
POS_API_TOKEN=cloud26#!
# How often to auto-sync medicines from POS (in minutes). Default: 60
POS_SYNC_INTERVAL_MINUTES=60

# K2 Connect (Kopo Kopo) — M-Pesa Buy Goods STK Push
# sandbox | production — use sandbox until the app is approved and you have live keys
K2_ENVIRONMENT=sandbox
K2_CLIENT_ID=your_k2_client_id_here
K2_CLIENT_SECRET=your_k2_client_secret_here
# Also used as the HMAC key to verify inbound webhook signatures (X-KopoKopo-Signature)
K2_API_KEY=your_k2_api_key_here
K2_TILL_NUMBER=your_till_number_here
# Must be a publicly reachable URL (use ngrok in local dev) — K2 posts the payment
# result here after the customer completes the STK prompt
K2_CALLBACK_URL=https://your-public-url/api/k2/webhook
